# Server configuration only. Every third-party key (Telegram bot token, api_id/api_hash,
# Paystack, Flutterwave, Resend, AI providers) is set by an administrator in
# Admin > Settings, where it is stored encrypted with SECRET_KEY.

# Database
DATABASE_URL=postgresql+asyncpg://swm_user:swm_password@localhost:5432/swm_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security: a long random value, set BEFORE saving keys in Settings. Changing it later
# makes saved keys unreadable (they then need re-entering).
SECRET_KEY=change-me-to-a-random-secret
APP_ENV=production

# Website upload ceiling for audio (also the hard limit of Telegram large files).
TELEGRAM_MAX_UPLOAD_MB=2000

# Legacy fallbacks, used only when nothing is saved in Admin > Settings. Prefer Settings.
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_ENCRYPTION_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# App
APP_NAME=Scent of Water Ministry
APP_URL=https://swm.tutapis.com
