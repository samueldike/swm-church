__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
dist/
build/
.venv/
venv/
node_modules/
.DS_Store
*.log

# Temp/test files
temp/
temp_*.py
check_*.py
fix_*.py
migrate_data.py
extract_mysql.py
run_server.py
seed_admin.py
*.pyc
!tests/test_*.py

# One-off VPS scratch scripts that carried hardcoded credentials — archived
# to .deploy-archive/. deploy.py is now the credential-free replacement (see
# deploy.py's own docstring) and is deliberately tracked, not ignored.
deploy[0-9]*.py
ssh_exec.py
vps_deploy.py
ins_audit.py
stage-*.json
.freebuff/
nul

# Legacy Laravel files
public/
html-templates/
.phpunit.result.cache
churchaly/

# Backup
swm-backup/
*.sql

# Local-only deploy credentials and archived one-off deploy scripts
.deploy-archive/
.env.deploy

# Runtime uploads (bind-mounted on the VPS), never committed
app/media/*
!app/media/.gitkeep

# Telegram archive (private backups of channel audio), never committed
telegram-archive/
app/telegram-archive/
*.stackdump
