# Database
DATABASE_URL=postgresql+asyncpg://swm_user:swm_password@localhost:5432/swm_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-secret
APP_ENV=production

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUDIO_CHAT_ID=
# Self-hosted Bot API server (docker-compose service "telegram-bot-api").
# Lifts uploads from 50MB to 2000MB and removes the 20MB getFile limit.
# Leave TELEGRAM_LOCAL_API=false to fall back to the 50MB cloud API.
TELEGRAM_API_BASE=http://telegram-bot-api:8081
TELEGRAM_LOCAL_API=true
TELEGRAM_MAX_UPLOAD_MB=2000
# Required by the telegram-bot-api container. Get these from https://my.telegram.org
# (Log in > API development tools). They are account-level, not bot-level.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Books Pub AI drafting: set the API key in Admin > Settings > AI drafting instead.
# These are only a fallback used when nothing is saved there.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Scent of Water Ministry

# App
APP_NAME=Scent of Water Ministry
APP_URL=https://swm.tutapis.com
