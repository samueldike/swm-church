.git
.gitignore
.env
.env.example
__pycache__
*.pyc
*.pyo
.mypy_cache
.pytest_cache
venv
.venv
node_modules
*.log
.DS_Store
plans/
swm-backup/
*.sql

# Runtime data: bind-mounted into the containers, never baked into the image
# (COPY . . once put the 4.4GB Whisper model cache into every image).
whisper-models/
telegram-archive/
app/telegram-archive/
# private document library (Admin -> Documents): office files must never be baked into an image
documents/
app/documents/
# uploaded at runtime into the server's bind-mounted folder
app/static/images/ministers/
app/media/*
!app/media/.gitkeep
media_files/
# Video Clipper working files (source videos, shorts): runtime data, never in git or the image
/clipper/
/app/clipper/
